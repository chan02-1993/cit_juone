
#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main() {
    int n, m;
    cin >> n >> m;
    vector<long long> cow(n);
    vector<long long> cc(m);
    vector<long long> eaten(m, 0);
    for (int i = 0; i < n; i++) {
        cin >> cow[i];
    }
    for (int i = 0; i < m; i++) {
        cin >> cc[i];
    }
    for (int i = 0; i < m; i++) { // loop for each cc
        for (int j = 0; j < n; j++) { // loop for each cow
            long long a, b, c;
            a = cc[i];
            b = eaten[i];
            c = cow[j];
            long long eat = max(min(a, c) - b, (long long)0);
            cow[j] += eat;
            eaten[i] = min(a, max(c, b));
            if (eaten[i] == cc[i]) break;
        }
    }
    for (long long i : cow) {
        cout << i << "\n";
    }
}
/*
* a=cc[x]
* b=eaten[x]
* c=cow[x]
* eaten=max(min(a,c)-b,0)
* left cc= min(a,max(c,b))
*/
