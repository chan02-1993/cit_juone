#include <iostream>
#include <vector>
#include <algorithm>
#include<string>
using namespace std;
using ll = long long;
void solve() {
    int n;
    cin >> n;
    vector<int> h(n);
    vector<int> a(n);
    vector<int> t(n);
    vector<int> pos(n);
    for (int i = 0; i < n; i++) {
        cin >> h[i];
    }
    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }
    for (int i = 0; i < n; i++) {
        cin >> t[i];
        pos[t[i]] = i;
    }
    ll mini = 0;
    ll maxi = 10000000000;
    for (int i = 0; i < n - 1; i++) {
        if (h[pos[i]] > h[pos[i + 1]]) {
            if (a[pos[i]] >= a[pos[i + 1]]) {
                continue;
            }
            else {
                maxi = min(maxi, (ll)((h[pos[i]] - h[pos[i + 1]]) / (a[pos[i + 1]] - a[pos[i]]) - ((h[pos[i]] - h[pos[i + 1]]) % (a[pos[i + 1]] - a[pos[i]]) == 0)));
            }
        }
        else {
            if (a[pos[i]] > a[pos[i + 1]]) {
                mini = max(mini, (ll)((h[pos[i + 1]] - h[pos[i]]) / (a[pos[i]] - a[pos[i + 1]]) + 1));
            }
            else {
                cout << -1;
                return;
            }
        }
    }
    if (maxi < mini) {
        cout << -1;
        return;
    }
    cout << mini;
    return;
}
int main() {
    int t;
    cin >> t;
    while (t--) {
        solve();
        cout << endl;
    }
}"
"
#include <iostream>
#include <vector>
#include <algorithm>
#include<string>
using namespace std;

int main() {
    int n;
    cin >> n;
    vector<int> cows(n);
    vector<int> groups;
    string in;
    cin >> in;
    for (int i = 0; i < n; i++) {
        cows[i] = in[i] - '0';
    }
    bool start, end;
    int before = 0;
    start = (cows[0]) ? true: false;
    end = (cows[n-1]) ? true : false;
    int cnt = 0;
    for (int i = 0; i < n; i++) {
        if (cows[i]==1) {
            cnt++;
        }
        if (cows[i]==0 && before==1) {
            groups.push_back(cnt);
            cnt = 0;
        }
        before = cows[i];
    }
    if (cnt) groups.push_back(cnt);
    int days = 1000000;
    for (int i = 0; i < groups.size(); i++) {
        if (i == 0 && start) days = min(days, groups[i]-1);
        else if (i == groups.size() - 1 && end) days = min(days, groups[i]-1);
        else days = min(days, (groups[i] - 1) / 2);
    }
    int ans = 0;
    for (int i = 0; i < groups.size(); i++) {
        if (i == 0 && start) {
            if (2 * days + 1 <= groups[i]) {
                ans += (groups[i] / (2 * days + 1));
                if (groups[i] % (2 * days + 1)) ans++;
            }
            else ans++;
        }
        else if (i == groups.size()-1 && end) {
            if (2 * days + 1 <= groups[i]) {
                ans += (groups[i] / (2 * days + 1));
                if (groups[i] % (2 * days + 1)) ans++;
            }
            else ans++;
        }
        else {
            ans += (groups[i] / (2 * days + 1));
            if (groups[i] % (2 * days + 1)) ans++;
        }
    }
    cout << ans;
}"
