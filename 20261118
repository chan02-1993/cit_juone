                cin >> cap_in[i];
        }
        for (int i = 1; i < n; i++) {
                if (cows_in[i] != cows_in[i - 1]){
                        flag=false;
                        break;
                }
        }
        ll total = accumulate(cap_in.begin(), cap_in.end(), (ll)0);
        if (flag) cout << total;
        else {
                vector<ll> groups;
                if (!(cows_in[0] == 'R' && cows_in[n-1] == 'L')) {
                        for (int i = 1; i < n; i++) {
                                if (cows_in[i] == 'R' && cows_in[i - 1] == 'L') {
                                        int idx = 0;
                                        for (int j = i; j < n; j++) {
                                                cows[idx] = cows_in[j];
                                                cap[idx] = cap_in[j];
                                                idx++;
                                        }
                                        for (int j = 0; j < i; j++) {
                                                cows[idx] = cows_in[j];
                                                cap[idx] = cap_in[j];
                                                idx++;
                                        }
                                        break;
                                }
                        }
                }
                else {
                        cows = cows_in;
                        cap = cap_in;
                }
                ll cur = cap[0];
                for (int i = 1; i < n; i++) {
                        if (cows[i] == 'L') {
                                if (cows[i - 1] == 'L') {
                                        cur += cap[i];
                                }
                                else {
                                        if (cur) cur-=cap[i - 1];
                                        groups.push_back(cur);
                                        cur = 0;
                                }
                        }
                        else {
                                if (cows[i - 1] == 'R') {
                                        cur += cap[i];
                                }
                                else {
                                        groups.push_back(cur);
                                        cur = cap[i];
                                }
                        }
                }
                groups.push_back(cur);
                ll ans = total;
                for (ll i : groups) {
                        ans -= min(i, (ll)m);
                }
