"#include <iostream>
#include <vector>
#include <algorithm>
#include<string>
#include<set>
#include<numeric>
using namespace std;
using ll = long long;
int main() {
	int n;
	cin >> n;
	vector<int> a(n); 
	vector<int> b(n);
	for (int i = 0; i < n; i++) {
		cin >> a[i];
	}
	for (int i = 0; i < n; i++) {
		cin >> b[i];
	}
	vector<int> cnt(n+1,0);
	int org=0;
	for (int i = 0; i < n; i++) {
		if (a[i] == b[i]) org++;
	}
	for (int i = 0; i < n; i++) { //odd cases
		int cur = org;
		for (int j = 0; j <= min(n - 1 - i, i); j++) {
			if (a[i - j] == b[i - j]) cur--;
			if (a[i + j] == b[i + j]) cur--;
			if (a[i - j] == b[i + j]) cur++;
			if (a[i + j] == b[i - j]) cur++;
			cnt[cur]++;
		}
	}
	for (int i = 0; i < n-1; i++) { //even cases
		int cur = org;
		for (int j = 0; j <= min(i, n - i - 2); j++) {
			if (a[i - j] == b[i - j]) cur--;
			if (a[i + j+1] == b[i + j+1]) cur--;
			if (a[i - j] == b[i + j+1]) cur++;
			if (a[i + j+1] == b[i - j]) cur++;
			cnt[cur]++;
		}
	}
	for (int i = 0; i < n+1; i++) {
		cout << cnt[i] << ""\n"";
	}
}"
"#include <iostream>
#include <vector>
#include <algorithm>
#include<string>
#include<set>
#include<numeric>
using namespace std;
using ll = long long;
int main() {
        int t;
        cin >> t;
        while (t--) {
                bool flag = true;
                int n, a, b;
                cin >> n >> a >> b;
                vector<vector<char>> stars(n, vector<char>(n));
                vector<vector<bool>> occ(n, vector<bool>(n,false));
                for (int i = 0; i < n; i++) {
                        for (int j = 0; j < n; j++) {
                                cin >> stars[i][j];
                        }
                }
                for (int i = 0; i < n; i++) {
                        for (int j=0; j < n; j++) {
                                if (stars[i][j] == 'B') {
                                        if (i - b >= 0 && j - a >= 0 && stars[i-b][j-a]!='W') {
                                                occ[i - b][j - a] = true;
                                                occ[i][j] = true;
                                        }
                                        else {
                                                flag = false;
                                        }
                                }
                        }
                }
                for (int i = 0; i < n; i++) {
                        for (int j=0; j < n; j++) {
                                if (stars[i][j] == 'G') {
                                        if (i - b < 0 || j - a < 0) {
                                                occ[i][j] = true;
                                        }
                                        else {
                                                if (!occ[i - b][j - a]) occ[i][j] = true;
                                        }
                                }
                        }
                }
                if (!flag) cout << -1;
                else {
                        int cnt = 0;
                        for (int i = 0; i < n; i++) {
                                for (int j = 0; j < n; j++) {
                                        if (occ[i][j]) cnt++;
                                }
                        }
                        cout << cnt;
                }
                cout << ""\n"";
        }
}"
"#include <iostream>
