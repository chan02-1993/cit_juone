#include<set>
#include<numeric>
using namespace std;
using ll = long long;
int main() {
        int n, q;
        cin >> n >> q;
        vector<vector<int>> xy(n,vector<int>(n,0));
        vector<vector<int>> yz(n, vector<int>(n, 0));
        vector<vector<int>> zx(n, vector<int>(n, 0));
        int ans = 0;
        while (q--) {
                int x, y, z;
                cin >> x >> y >> z;
                xy[x][y]++;
                yz[y][z]++;
                zx[z][x]++;
                if (xy[x][y] == n) ans++;
                if (yz[y][z] == n) ans++;
                if (zx[z][x] == n) ans++;
                cout << ans<<""\n"";
        }
}"
"#include <iostream>
#include <vector>
#include <algorithm>
#include<string>
#include<set>
#include<numeric>
using namespace std;
using ll = long long;
int main() {
        int t;
        cin >> t;
        while (t--) {
                int n;
                int one_cnt=0;
                cin >> n;
                vector<bool> checker(n+1, false); //1-base
                vector<int> h(n - 1); 
                vector<int> p(n);
                for (int i = 0; i < n - 1; i++) {
                        cin >> h[i];
                }
                if (h[n - 2] != 1) {
                        cout << -1;
                        if (t != 0) cout << ""\n"";
                        continue;
                }
                bool flag = true;
                for (int i = 0; i < n-1; i++) {
                        if (h[i] == 1) {
                                checker[1] = true;
                                one_cnt++;
                        }
                        else {
                                if (checker[h[i]] == true) {
                                        flag = false;
                                        continue;
                                }
                                checker[h[i]] = true;
                        }
                }
                if (!flag) {
                        cout << -1 ;
                        if (t != 0) cout << ""\n"";
                        continue;
                }
                if (one_cnt > 2) {
                        cout << -1;
                        if (t != 0) cout << ""\n"";
                        continue;
                }
                else if (one_cnt == 2) {
                        vector<int> missing;
                        if (h[n - 2] != 1) {
                                cout << -1;
                                if (t != 0) cout << ""\n"";
                                flag = false;
                                break;
                        }
                        for (int i = 1; i <= n; i++) {
                                if (!checker[i]) missing.push_back(i);
                        }
                        p[0] = min(missing[0], missing[1]);
                        p[n - 1] = max(missing[0], missing[1]);
                        p[n - 2] = h[0];
                        int a = 0;
                        int b = n - 2; 
                        int next = 1;
                        for (int i = 0; i < n - 3; i++) {
                                if (p[a] > p[b]) {
                                        a++;
                                        p[a] = h[next];
                                }
                                else {
                                        b--;
                                        p[b] = h[next];
                                }
                                next++;
                        }
                        for (int i = 0; i < n-1;i++) {
                                cout << p[i] << "" "";
                        }
                        cout << p[n - 1];

                }
                else {
                        vector<int> missing;
                        for (int i = 1; i <= n; i++) {
                                if (!checker[i]) missing.push_back(i);
                        }
                        reverse(h.begin(), h.end());
                        h.push_back(missing[0]);
                        for (int i = 0;i<h.size()-1;i++) {
                                cout << h[i] << "" "";
                        }
                        cout << h[h.size() - 1];
                }
                if(t!=0) cout << ""\n"";
        }
}"
